# Copy to .env for local development. Never commit a real .env* file (see .gitignore).

# PostgreSQL connection string used by Prisma. Easiest local option: `npx prisma dev` starts a
# local Postgres server and prints both of the values below (see prisma7.config.ts / README.md).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_firm_management?sslmode=disable"

# A separate database `prisma migrate dev` uses to compute schema diffs. `prisma dev` prints
# this too (as SHADOW_DATABASE_URL) - without it, migrate dev tries to improvise a shadow db on
# the main connection, which isn't reliable against `prisma dev`'s embedded Postgres.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_firm_management?sslmode=disable"
