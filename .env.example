# Copy to .env for local development. Never commit a real .env* file (see .gitignore).

# PostgreSQL connection string used by Prisma. Easiest local option: `npx prisma dev` starts a
# local Postgres server and prints a DATABASE_URL to use (see prisma7.config.ts / README.md).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_firm_management?sslmode=disable"
