generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The tenant root. Every other table carries organisationId scoping to it, even though only
/// one organisation exists today - see docs/ARCHITECTURE.md and CLAUDE.md's multi-tenant-ready
/// principle.
model Organisation {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments         Department[]
  roles               Role[]
  users               User[]
  sessions            Session[]
  rolePermissions     RolePermission[]
  skills              Skill[]
  employeeSkills      EmployeeSkill[]
  availabilities      Availability[]
  clients             Client[]
  clientEntities      ClientEntity[]
  contacts            Contact[]
  services            Service[]
  checklistTemplates  ChecklistTemplate[]
  checklistItems      ChecklistItem[]
  engagements         Engagement[]
  recurringConfigs    RecurringConfig[]
  tasks               Task[]
  taskSequences       TaskSequence[]
  taskStatusHistories TaskStatusHistory[]

  @@map("organisations")
}

model Department {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users        User[]
  services     Service[]
  tasks        Task[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("departments")
}

model Role {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("roles")
}

/// The fixed catalog of permission keys the app can enforce - "fixed" because a new permission
/// key needs new enforcement code to actually check it (adding a row here alone does nothing).
/// See docs/RBAC.md.
model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// What roles-as-data actually means: a role's permissions are these rows, not an `if (role ===
/// 'Manager')` branch in application code. Adding a new role (e.g. a future "Senior Associate")
/// is then just a new Role row + new RolePermission rows - no enforcement code changes.
model RolePermission {
  id             String   @id @default(uuid())
  organisationId String
  roleId         String
  permissionKey  String
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([organisationId])
  @@index([roleId])
  @@index([permissionKey])
  @@map("role_permissions")
}

model User {
  id             String   @id @default(uuid())
  organisationId String
  email          String
  name           String
  passwordHash   String
  isActive       Boolean  @default(true)
  departmentId   String?
  roleId         String?
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation        Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  department          Department?         @relation(fields: [departmentId], references: [id])
  role                Role?               @relation(fields: [roleId], references: [id])
  sessions            Session[]
  /// Self-referential reporting line. Nullable - not every employee has a manager assigned
  /// (e.g. a Partner at the top of the chain). Cycle prevention (an employee can't end up in
  /// their own reporting chain) is enforced in the service layer, not the schema - Postgres FKs
  /// can't express "no cycles."
  manager             User?               @relation("UserManager", fields: [managerId], references: [id])
  directReports       User[]              @relation("UserManager")
  employeeSkills      EmployeeSkill[]
  availabilities      Availability[]
  managedEntities     ClientEntity[]
  taskStatusHistories TaskStatusHistory[]
  tasks               Task[]

  @@unique([organisationId, email])
  @@index([organisationId])
  @@index([departmentId])
  @@index([roleId])
  @@index([managerId])
  @@map("users")
}

/// A logged-in session, looked up by the opaque id stored in the session cookie. Kept as its
/// own DB-backed table (not a stateless JWT) so a session can be revoked - see "human override
/// always wins" in CLAUDE.md.
model Session {
  id             String   @id @default(uuid())
  organisationId String
  userId         String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([userId])
  @@map("sessions")
}

/// The skill catalogue (PRD's "Employee Skill | Capability matrix" core entity). This is the
/// baseline data model only - the actual skills-matrix-driven allocation scoring is PRD Version
/// 3 (Intelligent Allocation), long after this; Days 25-26 just get the data captured so it
/// exists when that's built.
model Skill {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employeeSkills EmployeeSkill[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("skills")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

/// One employee's proficiency at one skill. Re-assigning the same skill to the same employee
/// updates the level rather than erroring - a skill level changing over time is the normal case,
/// not a conflict.
model EmployeeSkill {
  id             String     @id @default(uuid())
  organisationId String
  userId         String
  skillId        String
  level          SkillLevel
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([organisationId])
  @@index([userId])
  @@index([skillId])
  @@map("employee_skills")
}

enum AvailabilityType {
  LEAVE
  SICK
  UNAVAILABLE
}

/// Baseline leave/unavailability record (Day 27). "Rules enforced" at this stage means the
/// record itself has to make sense - valid date order, no overlapping periods for the same
/// employee - not task-aware blocking, since Task doesn't exist yet. Leave/availability
/// consideration in the actual allocation score is PRD Version 3, same as Skill above.
model Availability {
  id             String           @id @default(uuid())
  organisationId String
  userId         String
  type           AvailabilityType
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  reason         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([userId])
  @@map("availabilities")
}

/// The client/group master (PRD §6's top-level "Client/group", e.g. "ABC Group"). Deliberately
/// minimal - the PRD's per-entity fields (PAN, GSTIN, CIN, billing structure, etc.) belong to
/// the legal entities *under* a client/group, which is a separate later day (Day 32), not this
/// one. Contacts (Day 34) and engagements (Day 35) are separate too.
model Client {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  isActive       Boolean  @default(true)
  /// Persistent client-specific instructions/notes (PRD S6's "client-specific instructions" -
  /// Day 36). Lightweight, day-to-day content - gated on client:editContact like a contact's
  /// own fields, not client:editStructural like name/isActive, so it gets its own PATCH route
  /// rather than being folded into the structural one (see /api/clients/[id]/instructions).
  instructions   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entities     ClientEntity[]
  tasks        Task[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("clients")
}

/// A legal entity under a client/group (PRD §6, e.g. "ABC Private Limited" under "ABC Group").
/// Carries the compliance-identity fields the PRD lists per entity (PAN/GSTIN/CIN) - deliberately
/// still missing Primary Contact (Contact model, Day 34) and Services/Billing/Engagement Start
/// (Engagement model, Day 35), which the PRD lists on the same entity but depend on tables that
/// don't exist yet.
model ClientEntity {
  id               String   @id @default(uuid())
  organisationId   String
  clientId         String
  name             String
  pan              String?
  gstin            String?
  cin              String?
  accountManagerId String?
  phone            String?
  email            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountManager User?        @relation(fields: [accountManagerId], references: [id])
  contacts       Contact[]
  engagements    Engagement[]
  tasks          Task[]

  // PAN/GSTIN are national tax-identity numbers - genuinely unique per legal entity, so a
  // duplicate is a real data-entry error worth catching, not just noise. Postgres treats
  // multiple NULLs in a unique index as distinct, so entities without a PAN/GSTIN yet don't
  // conflict with each other.
  @@unique([clientId, name])
  @@unique([organisationId, pan])
  @@unique([organisationId, gstin])
  @@index([organisationId])
  @@index([clientId])
  @@index([accountManagerId])
  @@map("client_entities")
}

/// A person to reach at a client entity (PRD §6/§38's "Contact | Client contact", referenced as
/// each entity's "Primary Contact"). Lightweight, day-to-day data - gated on client:editContact
/// (Manager+Partner), not client:editStructural (Partner-only) like the entity's own compliance
/// fields, per RBAC.md's own description of editContact as covering exactly this ("contact
/// notes"). No isActive lifecycle like the other masters - a contact who's left is just removed,
/// not archived; this is a much lower-stakes record than an Employee or Client.
model Contact {
  id             String   @id @default(uuid())
  organisationId String
  entityId       String
  name           String
  designation    String?
  phone          String?
  email          String?
  /// At most one primary contact per entity - enforced in the service layer (clearing any
  /// existing primary when a new one is set), not a DB constraint, since "at most one true" per
  /// group isn't expressible as a plain unique index.
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entity       ClientEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, name])
  @@index([organisationId])
  @@index([entityId])
  @@map("contacts")
}

/// The service catalogue (PRD §7), e.g. "Taxation" (a top-level category, parentId null) with
/// "GST", "GSTR-1" etc. as children. Self-referential like User.managerId (Day 24) - same
/// reasoning: unlimited depth via one FK, cycle prevention in the service layer since Postgres
/// FKs can't express "no cycles". Carries every "each service should allow configuration of"
/// field from the PRD directly (Days 37/40 are the same model, not separate tables - department
/// + expected skill level are just fields here, "rules stored/retrieved" is trivially true of
/// any persisted field). The standard checklist (Day 41) is its own model below, not a field
/// here, since "template attaches to service" implies a real object with its own items.
model Service {
  id                      String      @id @default(uuid())
  organisationId          String
  name                    String
  parentId                String?
  departmentId            String?
  expectedSkillLevel      SkillLevel?
  turnaroundDays          Int?
  estimatedEffortMinHours Float?
  estimatedEffortMaxHours Float?
  reviewRequired          Boolean     @default(false)
  isRecurring             Boolean     @default(false)
  standardDocuments       String?
  isActive                Boolean     @default(true)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parent            Service?           @relation("ServiceHierarchy", fields: [parentId], references: [id])
  children          Service[]          @relation("ServiceHierarchy")
  department        Department?        @relation(fields: [departmentId], references: [id])
  checklistTemplate ChecklistTemplate?
  engagements       Engagement[]
  recurringConfig   RecurringConfig?
  tasks             Task[]

  // Name uniqueness is enforced in the service layer, not just this index - Postgres treats
  // every NULL in a unique index as distinct, so two top-level services (parentId null) with
  // the same name would NOT collide here even though they should.
  @@unique([organisationId, parentId, name])
  @@index([organisationId])
  @@index([parentId])
  @@index([departmentId])
  @@map("services")
}

/// A reusable checklist attached to exactly one service (PRD §7's "standard checklist" /
/// Day 41's "template attaches to service"). "Reusable" means its items get copied onto a Task
/// for that service once Task Engine exists (Day 44+) - not built yet, this is just the
/// template.
model ChecklistTemplate {
  id             String   @id @default(uuid())
  organisationId String
  serviceId      String   @unique
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  service      Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  items        ChecklistItem[]

  @@index([organisationId])
  @@map("checklist_templates")
}

model ChecklistItem {
  id                  String   @id @default(uuid())
  organisationId      String
  checklistTemplateId String
  label               String
  position            Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([checklistTemplateId])
  @@map("checklist_items")
}

enum BillingStructure {
  MONTHLY
  ASSIGNMENT
}

/// A standing client-service relationship (PRD §6's per-entity "Services / Engagement Start /
/// Billing Structure / Status" fields, Day 35). Links one ClientEntity to one Service - not the
/// Client/group directly, since PRD §6's example ties services to the individual entity (e.g.
/// "ABC Private Limited" engages GST separately from "ABC LLP"). Ending an engagement is a
/// status change (isActive: false, i.e. "terminate an engagement" per the client:editStructural
/// permission description), never a delete - the record stays as engagement history.
model Engagement {
  id               String           @id @default(uuid())
  organisationId   String
  clientEntityId   String
  serviceId        String
  engagementStart  DateTime
  billingStructure BillingStructure
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  clientEntity ClientEntity @relation(fields: [clientEntityId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])

  // One engagement per entity+service - re-engaging the same service on the same entity means
  // reactivating the existing row (isActive: true), not creating a second one.
  @@unique([clientEntityId, serviceId])
  @@index([organisationId])
  @@index([clientEntityId])
  @@index([serviceId])
  @@map("engagements")
}

enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

/// The recurrence calendar for one recurring Service (PRD §32: "generate recurring tasks
/// automatically based upon configured calendars"), e.g. GST filing on the 20th of every month.
/// Task Engine (Day 44+) doesn't exist yet, so this is the configuration + next-occurrence
/// computation baseline only - actually generating a Task from it is a later day's work, same as
/// the Day 41 checklist template being just the template.
model RecurringConfig {
  id             String              @id @default(uuid())
  organisationId String
  serviceId      String              @unique
  frequency      RecurrenceFrequency
  // Capped at 28 (not 31) so every month can honor it without ambiguity about "the 30th in
  // February" - a real edge case an accounting firm's monthly GST/TDS dates would hit often.
  dayOfMonth     Int
  // Only meaningful (and required) for ANNUALLY - e.g. ITR filing every October. Null for
  // MONTHLY; QUARTERLY always aligns to calendar quarters (Jan/Apr/Jul/Oct).
  monthOfYear    Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("recurring_configs")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/// How the task came to exist (PRD §11's "Source | WhatsApp/email/manual"). Only MANUAL is
/// produced today (Day 44/45) - WHATSAPP/EMAIL are AI Intake phase, much later, but the field
/// exists now so a manually created task is recorded as manual rather than defaulted to nothing.
enum TaskSource {
  MANUAL
  WHATSAPP
  EMAIL
}

/// The full PRD §12 status vocabulary, declared now because it's a fixed, already-specified set
/// of values - NOT because the workflow (which transitions are valid, who can trigger them) is
/// built yet. That's the Status State Machine's own day (Task Engine, "Workflow") later in this
/// phase; every task created before then just sits at its default status.
enum TaskStatus {
  NEW
  AI_PROCESSING
  AWAITING_ALLOCATION
  ASSIGNED
  IN_PROGRESS
  AWAITING_CLIENT_INFO
  AWAITING_INTERNAL_DEPENDENCY
  SUBMITTED_FOR_REVIEW
  REVIEW_IN_PROGRESS
  CORRECTION_REQUIRED
  APPROVED
  CLIENT_DELIVERY
  COMPLETED
  ARCHIVED
  CANCELLED
}

/// A work item (PRD §11). Carries both clientId and clientEntityId directly (not just derived
/// through the entity) because the PRD lists them as separate core fields, and it lets a task
/// list be filtered/queried by client without an extra join. Creating a task validates that the
/// entity belongs to the client AND that the entity actually has an active Engagement for the
/// service - a task should represent real, currently-engaged client work, not an arbitrary
/// client/entity/service combination (see assertEngagementActive in engagement.service.ts).
/// Fields the roadmap gives their own later day - assignedTo/reviewer (Assignment), startDate/
/// dueDate (Dates), attachments/dependencies/checklist/subtasks/comments (their own tables) -
/// are deliberately not here yet.
model Task {
  id             String       @id @default(uuid())
  organisationId String
  taskNumber     String
  clientId       String
  clientEntityId String
  departmentId   String?
  serviceId      String
  title          String
  priority       TaskPriority @default(NORMAL)
  source         TaskSource   @default(MANUAL)
  status         TaskStatus   @default(NEW)
  assignedToId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation        Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client              Client              @relation(fields: [clientId], references: [id])
  clientEntity        ClientEntity        @relation(fields: [clientEntityId], references: [id])
  department          Department?         @relation(fields: [departmentId], references: [id])
  service             Service             @relation(fields: [serviceId], references: [id])
  assignedTo          User?               @relation(fields: [assignedToId], references: [id])
  taskStatusHistories TaskStatusHistory[]

  @@unique([organisationId, taskNumber])
  @@index([organisationId])
  @@index([clientId])
  @@index([clientEntityId])
  @@index([serviceId])
  @@index([status])
  @@index([assignedToId])
  @@map("tasks")
}

/// A per-organisation, per-calendar-month monotonic counter backing Task.taskNumber (Day 45,
/// "IDs unique/readable"). The PRD's own example (`GST-ABC-2026-09-00127`) abbreviates service
/// and client names, but neither Service nor Client has a short-code field to derive that from
/// today - inventing one now would be guessing at a format the founder hasn't specified.
/// TASK-<year>-<month>-<sequence> is the simpler, still-unique-and-readable stand-in; the prefix
/// can change later without touching this counter's mechanics.
model TaskSequence {
  id             String @id @default(uuid())
  organisationId String
  yearMonth      String
  lastNumber     Int    @default(0)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, yearMonth])
  @@map("task_sequences")
}

/// One row per status-transition attempt - successful AND rejected (Day 48's own acceptance
/// check: "every invalid transition is blocked and logged", plus PRD §12's "a complete
/// timestamp trail should be maintained"). Scoped to Task status changes specifically, not a
/// generic audit log for every material action across the app - that's its own later feature
/// (Audit & Security phase). Task Engine's own "History" day reads from this same table rather
/// than duplicating it.
model TaskStatusHistory {
  id             String     @id @default(uuid())
  organisationId String
  taskId         String
  fromStatus     TaskStatus
  toStatus       TaskStatus
  succeeded      Boolean
  reason         String?
  changedById    String
  createdAt      DateTime   @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy    User         @relation(fields: [changedById], references: [id])

  @@index([organisationId])
  @@index([taskId])
  @@map("task_status_history")
}
