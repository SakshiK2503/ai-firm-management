# Copy to .env for local development. Never commit a real .env* file (see .gitignore).

# PostgreSQL connection string used by Prisma. Dev DB is a hosted Supabase project - see
# README.md's "Local development" section for exactly where to find these in Supabase's
# dashboard and why `uselibpqcompat=true` is needed.
DATABASE_URL="postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"

# A separate database `prisma migrate dev` uses to compute schema diffs - must NOT be the same
# database as DATABASE_URL (migrate dev creates/drops the whole schema in it). Create one with
# `CREATE DATABASE prisma_shadow;` against the direct connection, then point this at it.
SHADOW_DATABASE_URL="postgresql://postgres:<password>@<project-ref>.supabase.co:5432/prisma_shadow?sslmode=require&uselibpqcompat=true"
