generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The tenant root. Every other table carries organisationId scoping to it, even though only
/// one organisation exists today - see docs/ARCHITECTURE.md and CLAUDE.md's multi-tenant-ready
/// principle.
model Organisation {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments     Department[]
  roles           Role[]
  users           User[]
  sessions        Session[]
  rolePermissions RolePermission[]
  skills          Skill[]
  employeeSkills  EmployeeSkill[]
  availabilities  Availability[]

  @@map("organisations")
}

model Department {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("departments")
}

model Role {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("roles")
}

/// The fixed catalog of permission keys the app can enforce - "fixed" because a new permission
/// key needs new enforcement code to actually check it (adding a row here alone does nothing).
/// See docs/RBAC.md.
model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// What roles-as-data actually means: a role's permissions are these rows, not an `if (role ===
/// 'Manager')` branch in application code. Adding a new role (e.g. a future "Senior Associate")
/// is then just a new Role row + new RolePermission rows - no enforcement code changes.
model RolePermission {
  id             String   @id @default(uuid())
  organisationId String
  roleId         String
  permissionKey  String
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([organisationId])
  @@index([roleId])
  @@index([permissionKey])
  @@map("role_permissions")
}

model User {
  id             String   @id @default(uuid())
  organisationId String
  email          String
  name           String
  passwordHash   String
  isActive       Boolean  @default(true)
  departmentId   String?
  roleId         String?
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id])
  role         Role?        @relation(fields: [roleId], references: [id])
  sessions     Session[]
  /// Self-referential reporting line. Nullable - not every employee has a manager assigned
  /// (e.g. a Partner at the top of the chain). Cycle prevention (an employee can't end up in
  /// their own reporting chain) is enforced in the service layer, not the schema - Postgres FKs
  /// can't express "no cycles."
  manager   User?  @relation("UserManager", fields: [managerId], references: [id])
  directReports User[] @relation("UserManager")
  employeeSkills EmployeeSkill[]
  availabilities Availability[]

  @@unique([organisationId, email])
  @@index([organisationId])
  @@index([departmentId])
  @@index([roleId])
  @@index([managerId])
  @@map("users")
}

/// A logged-in session, looked up by the opaque id stored in the session cookie. Kept as its
/// own DB-backed table (not a stateless JWT) so a session can be revoked - see "human override
/// always wins" in CLAUDE.md.
model Session {
  id             String   @id @default(uuid())
  organisationId String
  userId         String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([userId])
  @@map("sessions")
}

/// The skill catalogue (PRD's "Employee Skill | Capability matrix" core entity). This is the
/// baseline data model only - the actual skills-matrix-driven allocation scoring is PRD Version
/// 3 (Intelligent Allocation), long after this; Days 25-26 just get the data captured so it
/// exists when that's built.
model Skill {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employeeSkills EmployeeSkill[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("skills")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

/// One employee's proficiency at one skill. Re-assigning the same skill to the same employee
/// updates the level rather than erroring - a skill level changing over time is the normal case,
/// not a conflict.
model EmployeeSkill {
  id             String     @id @default(uuid())
  organisationId String
  userId         String
  skillId        String
  level          SkillLevel
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([organisationId])
  @@index([userId])
  @@index([skillId])
  @@map("employee_skills")
}

enum AvailabilityType {
  LEAVE
  SICK
  UNAVAILABLE
}

/// Baseline leave/unavailability record (Day 27). "Rules enforced" at this stage means the
/// record itself has to make sense - valid date order, no overlapping periods for the same
/// employee - not task-aware blocking, since Task doesn't exist yet. Leave/availability
/// consideration in the actual allocation score is PRD Version 3, same as Skill above.
model Availability {
  id             String           @id @default(uuid())
  organisationId String
  userId         String
  type           AvailabilityType
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  reason         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([userId])
  @@map("availabilities")
}
